// Prisma schema for the portfolio API.
//
// Column/table names are mapped 1:1 to the original Laravel migrations so a
// straight `INSERT INTO ... SELECT` copy is possible when migrating from the
// old MySQL/Postgres database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  role            String    @default("admin")
  rememberToken   String?   @map("remember_token")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tokens ApiToken[]

  @@map("users")
}

/// Opaque bearer tokens, replacing Laravel Sanctum's personal_access_tokens.
model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  name       String
  abilities  String?
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

model Project {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  description    String
  longDescription String?  @map("long_description")
  projectRole    String?   @map("project_role")
  problem        String?
  solution       String?
  keyFeatures    Json?     @map("key_features")
  impact         String?
  tools          Json?     @map("tools")
  category       String?
  status         String    @default("draft")
  thumbnail      String?
  demoUrl        String?   @map("demo_url")
  githubUrl      String?   @map("github_url")
  featured       Boolean   @default(false)
  startDate      DateTime? @db.Date @map("start_date")
  endDate        DateTime? @db.Date @map("end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  images        ProjectImage[]
  projectSkills ProjectSkill[]

  @@map("projects")
}

model ProjectImage {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  image     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model Skill {
  id                   Int      @id @default(autoincrement())
  name                 String
  category             String
  percentage           Int      @default(0)
  showOnHome           Boolean  @default(false) @map("show_on_home")
  calculatedPercentage Int?     @map("calculated_percentage")
  projectCount         Int?     @map("project_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  projectSkills ProjectSkill[]

  @@map("skills")
}

/// Explicit join table so the data matches Laravel's `project_skill` table.
model ProjectSkill {
  projectId Int @map("project_id")
  skillId   Int @map("skill_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@map("project_skill")
}

model Experience {
  id          Int       @id @default(autoincrement())
  company     String
  position    String
  description String
  startDate   DateTime  @db.Date @map("start_date")
  endDate     DateTime? @db.Date @map("end_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  certificate String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("experiences")
}

model Certificate {
  id            Int       @id @default(autoincrement())
  title         String
  issuer        String
  description   String?
  date          DateTime? @db.Date
  expiresDate   DateTime? @db.Date @map("expires_date")
  credentialUrl String?   @map("credential_url")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("certificates")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  category  String   @default("General")
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  isReplied Boolean  @default(false) @map("is_replied")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  replies Reply[]

  @@map("inquiries")
}

model Reply {
  id        Int       @id @default(autoincrement())
  inquiryId Int       @map("inquiry_id")
  message   String
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("replies")
}

model Setting {
  id                    Int      @id @default(autoincrement())
  siteName              String   @map("site_name")
  tagline               String?
  name                  String?
  title                 String?
  email                 String?
  whatsapp              String?
  bio                   String?
  aboutMe               String?  @map("about_me")
  profileImage          String?  @map("profile_image")
  resume                String?
  github                String?
  linkedin              String?
  instagram             String?
  completedProjects     Int      @default(0) @map("completed_projects")
  techStackCount        Int      @default(0) @map("tech_stack_count")
  gpa                   String?
  autoUpdateSkillBadges Boolean @default(true) @map("auto_update_skill_badges")
  showLearningCurve     Boolean @default(true) @map("show_learning_curve")
  showGithubActivity    Boolean @default(true) @map("show_github_activity")
  metaTitle             String?  @map("meta_title")
  metaDescription       String?  @map("meta_description")
  metaKeywords          String?  @map("meta_keywords")
  ogTitle               String?  @map("og_title")
  ogDescription         String?  @map("og_description")
  ogImage               String?  @map("og_image")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Analytics {
  id        Int      @id @default(autoincrement())
  page      String?
  path      String?
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  referrer  String?
  visitedAt DateTime @default(now()) @map("visited_at")

  @@index([page])
  @@index([visitedAt])
  @@map("analytics")
}
